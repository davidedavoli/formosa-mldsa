inline fn __keccak_init_ref(reg ptr u32[25*2] state, reg u32 msf) -> reg ptr u32[25*2], #msf reg u32
{
  reg u32 i t tmp;

  tmp = 25*2;

  i = 0;
  t = 0;
  while(i < tmp)
  {
    msf = #update_msf(i < tmp, msf);
    state[(int)i] = t;
    i += 1;
  }
  msf = #update_msf(!(i < tmp), msf);

  return state, msf;
}


inline fn __add_seed_ref(reg ptr u32[25*2] state,
                         reg ptr u8[SEEDBYTES] in,
                         reg u32 msf) 
                      -> reg ptr u32[25*2], #msf reg u32
{
  reg u32 i t0 inlen4;

  inlen4 = SEEDBYTES >> 2;

  i = 0;
  while ( i < inlen4 )
  {
    msf = #update_msf(i < inlen4, msf);
    t0 = in[u32 (int)i];
    state[(int)i] = t0;
    i += 1;
  }
  msf = #update_msf(!(i < inlen4), msf);
  return state, msf;
}

inline fn __add_crh_ref(reg ptr u32[25*2] state,
                        reg ptr u8[CRHBYTES] in,
                        reg u32 msf) 
                     -> reg ptr u32[25*2], #msf reg u32
{
  reg u32 i t0 inlen4;

  inlen4 = CRHBYTES >> 2;

  i = 0;
  while ( i < inlen4 )
  {
    msf = #update_msf(i < inlen4, msf);
    t0 = in[u32 (int)i];
    state[(int)i] = t0;
    i += 1;
  }
  msf = #update_msf(!(i < inlen4), msf);
  return state, msf;
}

inline fn __add_ctilde_ref(reg ptr u32[25*2] state,
                         reg ptr u8[CTILDEBYTES] in,
                         reg u32 msf)
                      -> reg ptr u32[25*2], #msf reg u32
{
  reg u32 i t0 inlen4;

  inlen4 = CTILDEBYTES >> 2;

  i = 0;
  while ( i < inlen4 )
  {
    msf = #update_msf(i < inlen4, msf);
    t0 = in[u32 (int)i];
    state[(int)i] = t0;
    i += 1;
  }
  msf = #update_msf(!(i < inlen4), msf);
  return state, msf;
}

inline fn __add_seedrndcrh_ref(reg ptr u32[25*2] state,
                        reg ptr u8[SEEDBYTES + RNDBYTES + CRHBYTES] in,
                        reg u32 msf) 
                     -> reg ptr u32[25*2], #msf reg u32
{
  reg u32 i t0 inlen4;

  inlen4 = (SEEDBYTES + RNDBYTES + CRHBYTES) >> 2;

  i = 0;
  while ( i < inlen4 )
  {
    msf = #update_msf(i < inlen4, msf);
    t0 = in[u32 (int)i];
    state[(int)i] = t0;
    i += 1;
  }
  msf = #update_msf(!(i < inlen4), msf);
  return state, msf;
}


inline fn __add_mu_ref(reg ptr u32[25*2] state,
                         reg u32 pos,
                         reg ptr u8[2] in)
                      -> reg ptr u32[25*2]
{
  reg u32 t0 i j;
  j = 0;

  i = pos;
  t0 = (32u)in[(int)j];
  state[u8 (int)i] = (8u)t0;

  i += 1;
  j = 1;
  t0 = (32u)in[(int)j];
  state[u8 (int)i] = (8u)t0;

  return state;
}

inline fn __add_zero_after_add_naive(reg ptr u32[25*2] state, inline int pos, reg u32 msf) -> reg ptr u32[25*2], #msf reg u32
{
  reg u32 i, zero;
  zero = 0;

  i = pos;

  reg u32 tmp = 25 * 2 * 4;

  while (i < tmp) {
    msf = #update_msf((i < tmp), msf);
    state[u8 (int) i] = (8u)zero;
    i += 1;
  }
  msf = #update_msf(!(i < tmp), msf);
  return state, msf;
}

inline fn __add_nonce_ref(
  reg ptr u32[25*2] state, 
  inline int i, 
  reg u32 nonce) 
-> reg ptr u32[25*2] 
{
  state[u16 (int)i] = nonce;
  return state;
}


param int TRAIL_BYTE = 0x1f;

inline fn __add_block_end(
   reg ptr u32[25*2] state, 
   inline int i, 
   inline int rate
) -> reg ptr u32[25*2]
{
  reg u32 t0 t1;
  
  t0 = (32u) state[u8 (int)i];
  t0 ^= TRAIL_BYTE;
  state[u8 (int)i] = (8u) t0;

  rate -= 1;

  t0 = (32u) state[u8 rate];
  t1 = 0x80;
  t0 ^= t1;
  state[u8 rate] = (8u) t0;

  return state;
}

inline fn __add_zero_after_add(reg ptr u32[25*2] state, inline int nbbytes, reg u32 msf) -> reg ptr u32[25*2], #msf reg u32 
{
  reg u32 i, zero;
  zero = 0;

  #inline if (nbbytes % 2 == 1) { 
    state[u8 (int) nbbytes] = zero;
  } 

  nbbytes = nbbytes + ((nbbytes % 2 == 1) ? 1 : 0);
  #inline if (nbbytes % 4 == 2) { 
    state[u16 (int) (nbbytes / 2)] = zero;
  }

  nbbytes = nbbytes + ((nbbytes % 4 == 2) ? 2 : 0);

  i = (nbbytes / 4);

  reg u32 tmp = 25*2;

  while (i < tmp) {
    msf = #update_msf(i < tmp, msf);
    state[(int) i] = zero;
    i += 1;
  } 
  msf = #update_msf(!(i < tmp), msf);

  return state, msf;     
}

inline fn __SHAKE256_init_seed_ref(
  reg ptr u32[25*2] state,
  reg ptr u8[SEEDBYTES] seed,
  reg u32 msf
) -> reg ptr u32[25*2], #msf reg u32
{
  state, msf = __add_seed_ref(state, seed, msf);
  state, msf = __add_zero_after_add(state, SEEDBYTES, msf);
  reg u32 k = K;
  state[u8 SEEDBYTES] = k;
  reg u32 l = L;
  state[u8 SEEDBYTES+1] = l;
  state = __add_block_end(state, SEEDBYTES + 2, SHAKE256_RATE);
  state, msf = _keccakf1600_ref(state, msf);
  return state, msf;
}

inline fn __SHAKE256_init_ctilde_ref(
  reg ptr u32[25*2] state,
  reg ptr u8[CTILDEBYTES] seed,
  reg u32 msf
) -> reg ptr u32[25*2], #msf reg u32
{
  state, msf = __add_ctilde_ref(state, seed, msf);
  state, msf = __add_zero_after_add(state, CTILDEBYTES, msf);
  state = __add_block_end(state, CTILDEBYTES, SHAKE256_RATE);
  state,msf = _keccakf1600_ref(state, msf);
  return state, msf;
}

fn _stream128_init(
  reg ptr u32[25*2] state,
  reg ptr u8[SEEDBYTES] seed,
  reg u32 nonce,
  reg u32 msf
) -> reg ptr u32[25*2], #msf reg u32
{
  state, msf = __add_seed_ref(state, seed, msf);
  state = __add_nonce_ref(state, SEEDBYTES >> 1, nonce);
  state, msf = __add_zero_after_add(state, SEEDBYTES + 2, msf);
  state = __add_block_end(state, SEEDBYTES + 2, SHAKE128_RATE);
  state, msf = _keccakf1600_ref(state, msf);
  return state, msf;
}

fn _stream128_refill_buffer(
  reg ptr u32[25*2] state,
  reg ptr u32[N] a,
  reg u32 pos,
  reg u32 ctr,
  reg u32 q,
  #msf reg u32 msf
) -> reg ptr u32[25*2], reg ptr u32[N], reg u32, reg u32, reg u32, reg u32[3], #msf reg u32
{
  reg u32 tmpSR = SHAKE128_RATE >> 2;
  if (pos == tmpSR) {
    msf = #update_msf((pos == tmpSR), msf);
    stack u32 sctr;
    stack ptr u32[N] sa;
    sctr = ctr; sa = a;
    state, msf = _keccakf1600_ref(state, msf); 
    a = sa; pos = 0; ctr = sctr; q = __Q();
  } else {
    msf = #update_msf(!(pos == tmpSR), msf);
  }
  reg u32[3] buf;
  inline int i;
  for i = 0 to 3 { buf[i] = state[(int) pos]; pos += 1; }  
  return state, a, pos, ctr, q, buf, msf;
}

fn _stream256_init(
  reg ptr u32[25*2] state,
  reg ptr u8[CRHBYTES] seed,
  reg u32 nonce,
  reg u32 msf
) -> reg ptr u32[25*2], #msf reg u32
{
  state, msf = __add_crh_ref(state, seed, msf);
  state = __add_nonce_ref(state, CRHBYTES >> 1, nonce);
  state, msf = __add_zero_after_add(state, CRHBYTES + 2, msf);
  state = __add_block_end(state, CRHBYTES + 2, SHAKE256_RATE);
  state, msf = _keccakf1600_ref(state, msf);
  return state, msf;
}

fn _stream256_refill_buffer(
  reg ptr u32[25*2] state,
  reg ptr u32[N] a,
  reg u32 pos,
  reg u32 ctr,
  reg u32 n205,
  reg u32 msf
) -> reg ptr u32[25*2], reg ptr u32[N], reg u32, reg u32, reg u32, reg u32, #msf reg u32
{
  reg u32 tmpSR = SHAKE256_RATE >> 2;
  if (pos == tmpSR) {
    msf = #update_msf((pos == tmpSR), msf);
    stack u32 sctr;
    stack ptr u32[N] sa;
    sctr = ctr; sa = a;
    state, msf = _keccakf1600_ref(state, msf); 
    a = sa; pos = 0; ctr = sctr; n205 = 205;
  } else {
  msf = #update_msf(!(pos == tmpSR), msf);
  }
  reg u32 buf;
  buf = state[(int) pos]; pos += 1; 
  return state, a, pos, ctr, n205, buf, msf;
}

fn _stream256_full_squeeze (
  reg ptr u8[SHAKE256_RATE] buf, 
  reg ptr u32[25*2] state,
  reg u32 msf
) -> reg ptr u8[SHAKE256_RATE], #msf reg u32 {
  reg u32 i, t;
  i = 0;

  reg u32 tmpSR = SHAKE256_RATE / 4;
  while (i < tmpSR) {
    msf = #update_msf(i < tmpSR, msf);
    t = state[(int) i];
    buf[u32 (int) i] = t;
    i += 1;
  }
  msf = #update_msf(!(i < tmpSR), msf);
  return buf, msf;
}
         
   










  
   










