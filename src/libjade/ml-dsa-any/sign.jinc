/*************************************************
* Name:        JASMIN_MLDSA_crypto_sign_keypair
*
* Description: Generates public and private key.
*
* Arguments:   - uint8_t *pk: pointer to output public key (allocated
*                             array of JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES bytes)
*              - uint8_t *sk: pointer to output private key (allocated
*                             array of JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES bytes)
*
* Returns 0 (success)
**************************************************/

// TODO: factorize, this is almost a copy of the previous function
fn _shake256_PUBLICKEYBYTES_TRBYTES(reg ptr u8[TRBYTES] outp,
                                    reg ptr u8[ JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES] inp,
                                    reg u32 msf) -> reg ptr u8[TRBYTES], reg u32
{
  stack u32[25*2] state;
  reg ptr u32[25*2] pstate;
  reg u32 i j t s;

  pstate = state;
  pstate, msf = __keccak_init_ref(pstate, msf);
  () = #spill(outp);
  reg u32 last;

  i = 0;
  while {
    last = (JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES >> 2) - (SHAKE256_RATE >> 2);
  }
  (i < last)
  {
    j = 0;
    while (j < SHAKE256_RATE >> 2) {
      t = inp[u32 (int)i];
      s = pstate[(int)j];
      t ^= s;
      pstate[(int)j] = t;
      i += 1;
      j += 1;
    }
    () = #spill(i, inp);
    pstate, msf = _keccakf1600_ref(pstate, msf);
    () = #unspill(i, inp);
  }

  j = 0;
  while(i < JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES >> 2) {
    t = inp[u32 (int)i];
    s = pstate[(int)j];
    t ^= s;
    pstate[(int)j] = t;
    i += 1;
    j += 1;
  }

  /***
  *  FIXME : replace it by __add_block_end but warning
  ***/
  s = (32u)pstate[u8 (j * 4)];
  s ^= TRAIL_BYTE;
  pstate[u8 (j * 4)] = s;
  s = (32u) pstate[u8 (SHAKE256_RATE - 1)];
  s ^= 128;
  pstate[u8 (SHAKE256_RATE - 1)] = s;

  pstate, msf = _keccakf1600_ref(pstate, msf);

  () = #unspill(outp);
  // FIXME this copy is not necessary if we return pstate, in that case it should be taken as argument
  i = 0;
  while (i < TRBYTES / 4) {
    t = pstate[(int)i];
    outp[u32 (int)i] = t;
    i += 1;
  }

  return outp, msf;
}



/*************************************************
* Name:        JASMIN_MLDSA_crypto_sign_keypair_seed
*
* Description: Generates public and private key.
*
* Arguments:   - uint8_t *pk: pointer to output public key (allocated
*                             array of JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES bytes)
*              - uint8_t *sk: pointer to output private key (allocated
*                             array of JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES bytes)
*              - uint8_t *seed: pointer to input seed (allocated
*                             array of 2 * SEEDBYTES + CRHBYTES bytes)*
*
* Returns 0 (success)
**************************************************/
inline fn copy_polyvecl(reg ptr u32[polyvecl] s1hat, reg ptr u32[polyvecl] s1, reg u32 msf) -> reg ptr u32[polyvecl], reg u32 {
    reg u32 i, t;

    i = 0;
    while (i < polyvecl) {
      msf = #update_msf( (i < polyvecl), msf);
      t = s1[i];
      s1hat[i] = t;
      i += 1;
    }
    msf = #update_msf( !(i < polyvecl), msf);
    return s1hat, msf;
}

/***
*  FIXME: share the code with next function
***/
fn _crypto_sign_keypair_seed(reg ptr u8[JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES] pk, reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES] sk, reg ptr u8[SEEDBYTES] seedbuf, reg u32 msf) -> reg ptr u8[JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES], reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES], reg u32, reg u32 {
    reg u32 status;

    stack u8[TRBYTES] tr;
    stack u32[matKL] mat;
    stack u32[polyvecl] s1, s1hat;
    stack u32[polyveck] s2, t1, t0;

    /****
    * Implements shake256(seedbuf, 2 * SEEDBYTES + CRHBYTES, seedbuf, SEEDBYTES);
    ****/
    stack u32[PQC_SHAKECTX_BYTES*2] state;
    reg ptr u32[PQC_SHAKECTX_BYTES*2] pstate;
    pstate = state;

    () = #spill(pk, sk);
    pstate, msf = __SHAKE256_init_seed_ref(pstate, seedbuf, msf);
    state = pstate;
    /***/

    reg ptr u8[SEEDBYTES] rho;
    rho = state[u8 0:SEEDBYTES];

    /* Expand matrix */
    mat, msf = _polyvec_matrix_expand(mat, rho, msf);

    reg ptr u8[CRHBYTES] rhoprime;
    rhoprime = state[u8 SEEDBYTES:CRHBYTES];

    reg u32 nonce;
    nonce = 0;
    /* Sample short vectors s1 and s2 */
    s1, msf = _polyvecl_uniform_eta(s1, rhoprime, nonce, msf);
    nonce = L;
    rhoprime = state[u8 SEEDBYTES:CRHBYTES];
    s2, msf = _polyveck_uniform_eta(s2, rhoprime, nonce, msf);

    /* Matrix-vector multiplication */
    s1hat, msf = copy_polyvecl(s1hat, s1, msf);

    s1hat, msf = _polyvecl_ntt(s1hat, msf);
    t1, msf = _polyvec_matrix_pointwise_montgomery(t1, mat, s1hat, msf);
    t1, msf = _polyveck_reduce(t1, msf);
    t1, msf = _polyveck_invntt_tomont(t1, msf);

    /* Add error vector s2 */
    t1, msf = _polyveck_add_inplace(t1, s2, msf);

    /* Extract t1 and write public key */
    t1, msf = _polyveck_caddq(t1, msf);
    t1, t0 = _polyveck_power2round_inplace(t1, t0);

    () = #unspill(pk);
    rho = state[u8 0:SEEDBYTES];
    //() = #spill(s1, s2);
    pk = _pack_pk(pk, rho, t1);

    /* Compute H(rho, t1) and write secret key */
    () = #spill(pk);
    tr, msf = _shake256_PUBLICKEYBYTES_TRBYTES(tr, pk, msf);

    reg ptr u8[SEEDBYTES] key;
    rho = state[u8 0:SEEDBYTES];
    key = state[u8 SEEDBYTES + CRHBYTES : SEEDBYTES];

    () = #unspill(sk);
    sk = _pack_sk(sk, rho, tr, key, t0, s1, s2);
    () = #unspill(pk);

    status = 0;

    return pk, sk, status, msf;
}

fn _crypto_sign_keypair(reg ptr u8[JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES] pk, reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES] sk, reg u32 msf) -> reg ptr u8[JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES], reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES], reg u32, reg u32 {
    reg u32 status;

    stack u8[SEEDBYTES] seedbuf;
    stack u8[TRBYTES] tr;
    stack u32[matKL] mat;
    stack u32[polyvecl] s1 s1hat;
    stack u32[polyveck] s2, t1, t0;

    seedbuf = #randombytes(seedbuf);

    /****
    * Implements shake256(seedbuf, 2 * SEEDBYTES + CRHBYTES, seedbuf, SEEDBYTES);
    * Remark we use directly state as destination instead of seedbuf.
    ****/
    stack u32[PQC_SHAKECTX_BYTES*2] state;
    reg ptr u32[PQC_SHAKECTX_BYTES*2] pstate;
    pstate = state;

    () = #spill(pk, sk);
    pstate, msf = __SHAKE256_init_seed_ref(pstate, seedbuf, msf);
    state = pstate;
    /***/

    reg ptr u8[SEEDBYTES] rho;
    rho = state[u8 0:SEEDBYTES];

    /* Expand matrix */
    mat, msf = _polyvec_matrix_expand(mat, rho, msf);

    reg ptr u8[CRHBYTES] rhoprime;
    rhoprime = state[u8 SEEDBYTES:CRHBYTES];

    reg u32 nonce;
    nonce = 0;
    /* Sample short vectors s1 and s2 */
    s1, msf = _polyvecl_uniform_eta(s1, rhoprime, nonce, msf);
    nonce = L;
    rhoprime = state[u8 SEEDBYTES:CRHBYTES];
    s2, msf = _polyveck_uniform_eta(s2, rhoprime, nonce, msf);

    /* Matrix-vector multiplication */
    s1hat, msf = copy_polyvecl(s1hat, s1, msf);

    s1hat, msf = _polyvecl_ntt(s1hat, msf);
    t1, msf = _polyvec_matrix_pointwise_montgomery(t1, mat, s1hat, msf);
    t1, msf = _polyveck_reduce(t1, msf);
    t1, msf = _polyveck_invntt_tomont(t1, msf);

    /* Add error vector s2 */
    t1, msf = _polyveck_add_inplace(t1, s2, msf);

    /* Extract t1 and write public key */
    t1, msf = _polyveck_caddq(t1, msf);
    t1, t0 = _polyveck_power2round_inplace(t1, t0);

    () = #unspill(pk);
    rho = state[u8 0:SEEDBYTES];
    //() = #spill(s1, s2);
    pk = _pack_pk(pk, rho, t1);

    /* Compute H(rho, t1) and write secret key */
    () = #spill(pk);
    tr, msf = _shake256_PUBLICKEYBYTES_TRBYTES(tr, pk, msf);
    () = #unspill(sk);
    reg ptr u8[SEEDBYTES] key;

    rho = state[u8 0:SEEDBYTES];
    key = state[u8 SEEDBYTES + CRHBYTES : SEEDBYTES];
    sk = _pack_sk(sk, rho, tr, key, t0, s1, s2);
    () = #unspill(pk);

    status = 0;

    return pk, sk, status, msf;
}

/***
* Precondition:
  - pos is a multiple of 4
***/
fn _shake256_inc_absorb_mem
  (reg ptr u32[25*2] pstate,
   reg u32 pos,
   reg u32 m,
   reg u32 mlen, reg u32 msf) -> reg ptr u32[25*2], reg u32, reg u32
{
  reg u32 t s aux;

  aux = __imm_sub_reg(SHAKE256_RATE, pos);
  if (aux <= mlen) {
  // for (i = 0; i < r - (uint32_t)s_inc[25]; i++) {
    while (pos < SHAKE256_RATE) {
    // s_inc[(s_inc[25] + i) >> 3] ^= (uint64_t)m[i] << (8 * ((s_inc[25] + i) & 0x07));
      t = (u32)[m];
      s = pstate.[pos];
      s ^= t;
      pstate.[pos] = s;
      pos += 4; m += 4;
      mlen -= 4;
    }

    while {
      () = #spill(m, mlen);
      pstate, msf = _keccakf1600_ref(pstate,msf);
      () = #unspill(m, mlen);
      pos = 0;
    }
    // FIXME: it will be good to be able to write (SHAKE256_RATE < mlen)
    (mlen > SHAKE256_RATE)
    {
      while (pos < SHAKE256_RATE) {
        t = (u32)[m];
        s = pstate.[pos];
        s ^= t;
        pstate.[pos] = s;
        pos += 4; m += 4;
      }
      mlen -= SHAKE256_RATE;
    }
  }

  // Invariant mlen < SHAKE256_RATE - pos
  while (mlen > 0) {
    t = (32u)(u8)[m];
    s = (32u)pstate[u8 pos];
    s ^= t;
    pstate[u8 pos] = s;
    pos += 1; m += 1; mlen -= 1;
  }
  return pstate, pos, msf;
}


/***
* No precondition
***/
fn _shake256_inc_absorb_mem_naive
  (reg ptr u32[25*2] pstate,
   reg u32 pos,
   reg u32 m,
   reg u32 mlen,
   reg u32 msf) -> reg ptr u32[25*2], reg u32, reg u32
{
 reg u32 t s;

  // While input is not consumed :
  // Fill-in sponge part of the shake buffer byte by byte while xoring
  // If sponge is filled : keccak the buffer
  while (mlen != 0) {
    msf = #update_msf((mlen != 0), msf);

    t = (32u)(u8)[m];
    s = (32u)pstate[u8 pos];
    s ^= t;
    pstate[u8 pos] = s;
    pos += 1; m += 1; mlen -= 1;

    if (pos == SHAKE256_RATE) {
      msf = #update_msf((pos == SHAKE256_RATE), msf);
      () = #spill(m, mlen);
      pstate, msf = _keccakf1600_ref(pstate, msf);
      () = #unspill(m, mlen);
      mlen = #protect(mlen, msf);
      m = #protect(m, msf);
      pos = 0;
    } else {
      msf = #update_msf(!(pos == SHAKE256_RATE), msf);
    }

  }
   msf = #update_msf(!(mlen != 0), msf);
  return pstate, pos, msf;
}

/***
* No precondition
***/
inline fn _shake256_inc_absorb_KPOLYW1_PACKEDBYTES_naive
  (reg ptr u32[25*2] pstate,
   reg u32 pos,
   reg ptr u8[K * POLYW1_PACKEDBYTES] m,
   reg u32 msf
  ) -> reg ptr u32[25*2], reg u32, reg u32
{
 reg u32 t s;
 reg u32 ctr;
 ctr = 0;

  // While input is not consumed :
  // Fill-in sponge part of the shake buffer byte by byte by xoring
  // If sponge is filled : keccak the buffer
  while (ctr != K * POLYW1_PACKEDBYTES) {
    msf = #update_msf((ctr != K * POLYW1_PACKEDBYTES), msf);

    t = (32u)m[ctr];
    s = (32u)pstate[u8 pos];
    s ^= t;
    pstate[u8 pos] = s;
    pos += 1; ctr += 1;
    if (pos == SHAKE256_RATE) {
      msf = #update_msf((pos == SHAKE256_RATE), msf);
      () = #spill(ctr, pos, m);
      pstate, msf = _keccakf1600_ref(pstate, msf);
      () = #unspill(ctr, m);
      ctr = #protect(ctr, msf);
      m = #protect_ptr(m, msf);
      pos = 0;
    } else {
      msf = #update_msf(!(pos == SHAKE256_RATE), msf);
    }
  }
  msf = #update_msf(!(ctr != K * POLYW1_PACKEDBYTES), msf);

  return pstate, pos, msf;
}
/***
* Precondition CRHBYTES should have been filled in pstate
* CRHBYTES + K * POLYW1_PACKEDBYTES is dividable by 4 and 136
***/
fn _shake256_inc_absorb_KPOLYW1_PACKEDBYTES
  (reg ptr u32[25*2] pstate,
   reg ptr u8[K * POLYW1_PACKEDBYTES] m,
   reg u32 msf
  ) -> reg ptr u32[25*2], reg u32, reg u32
{
  reg u32 t s i pos;
  i = 0;
  pos = CRHBYTES;
  while (pos < SHAKE256_RATE) {
    s = m.[u32 i];
    pstate.[pos] = s;
    pos += 4; i += 4;
  }

  while {
    () = #spill(m, i);
    pstate, msf = _keccakf1600_ref(pstate, msf);
    () = #unspill(m, i);
    pos = 0;
  }
  (i < K * POLYW1_PACKEDBYTES)
  {
    while (pos < SHAKE256_RATE) {
      t = m.[u32 i];
      s = pstate.[pos];
      s ^= t;
      pstate.[pos] = s;
      pos += 4; i += 4;
    }
  }

  return pstate, pos, msf;
}

/** FIXME : This is __add_block_end, but with "i" a reg **/
fn _shake256_inc_finalize(
   reg ptr u32[25*2] state,
   reg u32 i
) -> reg ptr u32[25*2]
{
  reg u32 t0 t1;

  t0 = (32u) state[u8 (int)i];
  t0 ^= TRAIL_BYTE;
  state[u8 (int)i] = (8u) t0;

  t0 = (32u) state[u8 SHAKE256_RATE - 1];
  t1 = 0x80;
  t0 ^= t1;
  state[u8 SHAKE256_RATE - 1] = (8u) t0;

  return state;
}

/*************************************************
* Name:        crypto_sign_signature_ctx
*
* Description: Computes signature.
*
* Arguments:   - uint8_t *sig:   pointer to output signature (of length PQCLEAN_MLDSA_CLEAN_CRYPTO_BYTES)
*              - size_t *siglen: pointer to output length of signature
*              - uint8_t *m:     pointer to message to be signed
*              - size_t mlen:    length of message
*              - uint8_t *ctx:   pointer to context string
*              - size_t ctxlen:  length of context string
*              - uint8_t *sk:    pointer to bit-packed secret key
*
* Returns 0 (success) or -1 (context string too long)
**************************************************/
fn _crypto_sign_signature_ctx
  (reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES] sig,
   reg ptr u32[2] ctx_m,  // This is the two pointers 
   reg ptr u32[3] ctxlen_mlen_siglen, // all the length are public
   reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES] sk,
   reg u32 msf)
   -> reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES], reg u32, reg u32
{
  sig = sig; ctx_m = ctx_m; ctxlen_mlen_siglen = ctxlen_mlen_siglen; sk = sk;
  reg u32 status;
  stack u8[SEEDBYTES] s_rho;
  stack u8[TRBYTES] s_tr;
  stack u8[CRHBYTES] s_rhoprime;
  stack u32[polyveck] s_t0, s_s2;
  stack u32[polyvecl] s_s1;
  stack u8[SEEDBYTES + RNDBYTES + CRHBYTES] s_key_rnd_mu;
  stack u32[25*2] state;

  reg ptr u8[SEEDBYTES] rho, key;
  reg ptr u8[TRBYTES] tr;
  reg ptr u32[polyveck] t0, s2;
  reg ptr u32[polyvecl] s1;
  reg ptr u8[RNDBYTES] rnd;
  reg ptr u8[CRHBYTES] mu rhoprime;
  reg ptr u8[SEEDBYTES + RNDBYTES + CRHBYTES] key_rnd_mu;
  reg ptr u8[2] mu2;
  reg ptr u32[25*2] pstate;

  reg u32 pos m mlen ctx ctxlen t;

  inline int i;

  status = 0;

  ctxlen = ctxlen_mlen_siglen[0];

  if (ctxlen > 255) { 
    msf = #update_msf((ctxlen > 255), msf);
    status = - 1; 
  } else {

  msf = #update_msf(!(ctxlen > 255), msf);

  rho = s_rho; tr = s_tr; key = s_key_rnd_mu[0:SEEDBYTES];
  t0 = s_t0; s1 = s_s1; s2 = s_s2;

  () = #spill(sig, status, ctxlen);
  (rho, tr, key, t0, s1, s2, msf) = _unpack_sk(rho, tr, key, t0, s1, s2, sk, msf);
  tr = #protect_ptr(tr, msf);
  #declassify rho = rho; // rho goes to the public key
  s_rho = rho; s_tr = tr; s_t0 = t0; s_s1 = s1; s_s2 = s2;
  s_key_rnd_mu[0:SEEDBYTES] = key;

  mu2 = s_key_rnd_mu[SEEDBYTES + RNDBYTES : 2];
  t = 0;
  mu2[0] = (8u)t;
  t = ctxlen_mlen_siglen[0];
  mu2[1] = (8u)t;
  s_key_rnd_mu[SEEDBYTES + RNDBYTES : 2] = mu2;

  pstate = state;
  // TRBYTES (64) + 2 < SHAKE256_RATE (136)
  pstate, msf = __add_crh_ref(pstate, tr, msf); // TRBYTES = CRHBYTES
  pstate = __add_mu_ref(pstate, TRBYTES, mu2); // 2
  pstate, msf = __add_zero_after_add_naive(pstate, TRBYTES + 2, msf);
  pos = TRBYTES + 2;
  ctx = ctx_m[0];
  ctx = #protect(ctx, msf);
  () = #spill(ctx_m, ctxlen_mlen_siglen);
  () = #unspill(ctxlen);
  ctxlen = #protect(ctxlen, msf);
  pstate, pos, msf = _shake256_inc_absorb_mem_naive(pstate, pos, ctx, ctxlen, msf);
  () = #unspill(ctx_m, ctxlen_mlen_siglen);
  ctx_m =  #protect_ptr(ctx_m, msf);
  ctxlen_mlen_siglen = #protect_ptr(ctxlen_mlen_siglen, msf);
  mlen = ctxlen_mlen_siglen[1];
  mlen = #protect(mlen, msf);
  m = ctx_m[1];
  m = #protect(m, msf);
  pstate, pos, msf = _shake256_inc_absorb_mem_naive(pstate, pos, m, mlen, msf);
  pstate = _shake256_inc_finalize(pstate, pos);
  pstate, msf = _keccakf1600_ref(pstate, msf);

  // FIXME define a function for that
  mu = s_key_rnd_mu[SEEDBYTES + RNDBYTES : CRHBYTES];
  for i = 0 to CRHBYTES/4 {
    t = pstate[i];
    mu[u32 i] = t;
  }
  s_key_rnd_mu[SEEDBYTES + RNDBYTES : CRHBYTES] = mu;

  rnd = s_key_rnd_mu[SEEDBYTES : RNDBYTES];
  rnd = #randombytes(rnd);
  msf = #init_msf();
  s_key_rnd_mu[SEEDBYTES : RNDBYTES] = rnd;

  key_rnd_mu = s_key_rnd_mu;
  pstate, msf = __add_seedrndcrh_ref(pstate, key_rnd_mu, msf);
  pstate, msf = __add_zero_after_add(pstate, SEEDBYTES + RNDBYTES + CRHBYTES, msf);
  pstate = __add_block_end(pstate, SEEDBYTES + RNDBYTES + CRHBYTES, SHAKE256_RATE);
  pstate, msf = _keccakf1600_ref(pstate, msf);
  state = pstate;
  rhoprime = s_rhoprime;
  for i = 0 to CRHBYTES/4 {
    t = pstate[i];
    rhoprime[u32 i] = t;
  }
  s_rhoprime = rhoprime;

  stack u32[matKL] s_mat;
  stack u32[polyvecl] s_y, s_z;
  stack u32[polyveck] s_h;
  reg ptr u32[matKL] mat;
  reg ptr u32[polyveck] h;
  stack u32[polyveck] s_w1 s_w0;
  stack u32[N] s_cp;
  reg ptr u32[polyveck] w1 w0;
  reg ptr u32[N] cp;
  mat = s_mat; rho = s_rho;
  mat, msf = _polyvec_matrix_expand(mat, rho, msf); s_mat = mat;
  s1 = s_s1; s1, msf = _polyvecl_ntt(s1, msf); s_s1 = s1;
  s2 = s_s2; s2, msf = _polyveck_ntt(s2, msf); s_s2 = s2;
  t0 = s_t0; t0, msf = _polyveck_ntt(t0, msf); s_t0 = t0;

  reg u32 continue nonce r0;
  stack u32 s_nonce;
  r0 = 0;
  s_nonce = r0;
  while {
    /* Sample intermediate vector y */
    rhoprime = s_rhoprime;
    nonce = s_nonce;
    s_y, msf = _polyvecl_uniform_gamma1(s_y, rhoprime, nonce, msf);
    nonce = s_nonce; nonce += 1; s_nonce = nonce;

    /* Matrix-vector multiplication */
    s_z, msf = copy_polyvecl(s_z, s_y, msf);
    s_z, msf = _polyvecl_ntt(s_z, msf);
    mat = s_mat;
    w1 = s_w1; w1, msf = _polyvec_matrix_pointwise_montgomery(w1, mat, s_z, msf);
    w1, msf = _polyveck_reduce(w1, msf);
    w1, msf = _polyveck_invntt_tomont(w1, msf);

    /* Decompose w and call the random oracle */
    w1, msf = _polyveck_caddq(w1, msf);
    w0 = s_w0;
    w1, s_w0, msf = _polyveck_decompose_inplace(w1, w0, msf);
    s_w1 = w1;
    () = #unspill(sig);
    sig = #protect_ptr(sig, msf);
    reg ptr u8[K * POLYW1_PACKEDBYTES] sig1;
    sig1 = sig[0: K * POLYW1_PACKEDBYTES];
    sig1, msf = _polyveck_pack_w1(sig1, w1, msf);
    sig[0: K * POLYW1_PACKEDBYTES] = sig1;
    () = #spill(sig);
    // SHAKE256
    pstate = state; mu = s_key_rnd_mu[SEEDBYTES + RNDBYTES : CRHBYTES];
    pstate, msf = __add_crh_ref(pstate, mu, msf);
    pstate, msf = __add_zero_after_add(pstate, CRHBYTES, msf);
    pstate, pos, msf = _shake256_inc_absorb_KPOLYW1_PACKEDBYTES_naive(pstate, CRHBYTES, sig1, msf);
    pstate = _shake256_inc_finalize(pstate, pos);
    pstate, msf = _keccakf1600_ref(pstate, msf);
    // FIXME define a function for that

    reg ptr u8[CTILDEBYTES] sigctilde;
    () = #unspill(sig);
    sig = #protect_ptr(sig, msf);
    sigctilde = sig[0:CTILDEBYTES];
    for i = 0 to CTILDEBYTES/4 {
      t = pstate[i];
      sigctilde[u32 i] = t;
    }
    state = pstate;
    sig[0:CTILDEBYTES] = sigctilde;

    reg ptr u8[SEEDBYTES] sigseed;
    sigseed = sig[0:SEEDBYTES];
    () = #spill(sig);
    cp = s_cp;
    cp, msf = _poly_challenge(cp, sigctilde, msf);
    cp, msf = _poly_ntt(cp, msf);
    /* Compute z, reject if it reveals secret */
    s1 = s_s1;
    s_z, msf = _polyvecl_pointwise_poly_montgomery(s_z, cp, s1, msf); s_cp = cp;
    s_z, msf = _polyvecl_invntt_tomont(s_z, msf);
    s_z, msf = _polyvecl_add_inplace(s_z, s_y, msf);
    s_z, msf = _polyvecl_reduce(s_z, msf);

    reg u32 chknorm bound;
    bound = iGAMMA1 - BETA;
    chknorm, msf = _polyvecl_chknorm(s_z, bound, msf);
    () = #spill(sig);
    if (chknorm != 0) {
      continue = 1;
    } else {
      s2 = s_s2; h = s_h;
      h, msf = _polyveck_pointwise_poly_montgomery(h, cp, s2, msf);
      h, msf = _polyveck_invntt_tomont(h, msf); s_h = h;
      w0 = s_w0;
      w0, msf = _polyveck_sub_inplace(w0, h, msf);
      w0, msf = _polyveck_reduce(w0, msf);
      s_w0 = w0;
      bound = iGAMMA2 - BETA;
      chknorm, msf = _polyveck_chknorm(w0, bound, msf);
      if (chknorm != 0) {
        continue = 1;
      } else {
        cp = s_cp; t0 = s_t0;
        h = h;  // Needed for regalloc
        h, msf = _polyveck_pointwise_poly_montgomery(h, cp, t0, msf);
        h, msf = _polyveck_invntt_tomont(h, msf);
        h = h; // Needed for regalloc
        h, msf = _polyveck_reduce(h, msf); s_h = h;

        bound = iGAMMA2;
        chknorm, msf = _polyveck_chknorm(h, bound, msf);
        if (chknorm != 0) {
          continue = 1;
        } else {
          w0 = s_w0;
          w0, msf = _polyveck_add_inplace(w0, h, msf);
          s_w0 = w0; w1 = s_w1;
          reg u32 n;
          n, h, msf = _polyveck_make_hint(h, w0, w1, msf); s_h = h;
          inline bool test;
          #declassify test = __cmp_lt_u_imm(OMEGA, n); // OMEGA < n; 
          // if (n > OMEGA) 
          if (test) {
            continue = 1;
          } else {
            () = #unspill(sig);
            sig, msf = _pack_sig_nocopy(sig, s_z, h, msf);
            () = #spill(sig);
            continue = 0;
          }
        }
      }
    }
  } (continue == 1)
  status = 0;
  () = #unspill(sig);
  }
  return sig, status, msf;
}

/*************************************************
* Name:        crypto_sign_signature_ctx_seed
*
* Description: Computes signature.
*
* Arguments:   - uint8_t *sig:   pointer to output signature (of length PQCLEAN_MLDSA_CLEAN_CRYPTO_BYTES)
*              - size_t *siglen: pointer to output length of signature
*              - uint8_t *m:     pointer to message to be signed
*              - size_t mlen:    length of message
*              - uint8_t *ctx:   pointer to context string
*              - size_t ctxlen:  length of context string
*              - uint8_t *sk:    pointer to bit-packed secret key
*              - uint8_t *rand:  pointer to randomness (of length RNDBYTES)
*
* Returns 0 (success) or -1 (context string too long)
**************************************************/
fn _crypto_sign_signature_ctx_seed
  (reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES] sig,
   reg ptr u32[3] ctx_m_rand,
   reg ptr u32[3] ctxlen_mlen_siglen,
   reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES] sk,
   reg u32 msf)
   -> reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES], reg u32, reg u32
{
  sig = sig; ctx_m_rand = ctx_m_rand; ctxlen_mlen_siglen = ctxlen_mlen_siglen; sk = sk;
  reg u32 status;
  stack u8[SEEDBYTES] s_rho;
  stack u8[TRBYTES] s_tr;
  stack u8[CRHBYTES] s_rhoprime;
  stack u32[polyveck] s_t0, s_s2;
  stack u32[polyvecl] s_s1;
  stack u8[SEEDBYTES + RNDBYTES + CRHBYTES] s_key_rnd_mu;
  stack u32[25*2] state;

  reg ptr u8[SEEDBYTES] rho, key;
  reg ptr u8[TRBYTES] tr;
  reg ptr u32[polyveck] t0, s2;
  reg ptr u32[polyvecl] s1;
  reg ptr u8[RNDBYTES] rnd;
  reg ptr u8[CRHBYTES] mu rhoprime;
  reg ptr u8[SEEDBYTES + RNDBYTES + CRHBYTES] key_rnd_mu;
  reg ptr u8[2] mu2;
  reg ptr u32[25*2] pstate;

  reg u32 pos m mlen ctx ctxlen t;

  inline int i;

  status = 0;

  ctxlen = ctxlen_mlen_siglen[0];

  if (ctxlen > 255) { status = - 1; }

  if (status == 0) {

  rho = s_rho; tr = s_tr; key = s_key_rnd_mu[0:SEEDBYTES];
  t0 = s_t0; s1 = s_s1; s2 = s_s2;

  () = #spill(sig, status, ctxlen);
  (rho, tr, key, t0, s1, s2, msf) = _unpack_sk(rho, tr, key, t0, s1, s2, sk, msf);
  s_rho = rho; s_tr = tr; s_t0 = t0; s_s1 = s1; s_s2 = s2;
  s_key_rnd_mu[0:SEEDBYTES] = key;

  mu2 = s_key_rnd_mu[SEEDBYTES + RNDBYTES : 2];
  t = 0;
  mu2[0] = (8u)t;
  t = ctxlen_mlen_siglen[0];
  mu2[1] = (8u)t;
  s_key_rnd_mu[SEEDBYTES + RNDBYTES : 2] = mu2;

  pstate = state;
  // TRBYTES (64) + 2 < SHAKE256_RATE (136)
  pstate, msf = __add_crh_ref(pstate, tr, msf); // TRBYTES = CRHBYTES
  pstate = __add_mu_ref(pstate, TRBYTES, mu2); // 2
  pstate, msf = __add_zero_after_add_naive(pstate, TRBYTES + 2, msf);
  pos = TRBYTES + 2;
  ctx = ctx_m_rand[0];
  () = #spill(ctx_m_rand, ctxlen_mlen_siglen);
  () = #unspill(ctxlen);
  pstate, pos, msf = _shake256_inc_absorb_mem_naive(pstate, pos, ctx, ctxlen, msf);
  () = #unspill(ctx_m_rand, ctxlen_mlen_siglen);
  mlen = ctxlen_mlen_siglen[1];
  m = ctx_m_rand[1];
  () = #spill(ctx_m_rand);
  pstate, pos, msf = _shake256_inc_absorb_mem_naive(pstate, pos, m, mlen, msf);
  pstate = _shake256_inc_finalize(pstate, pos);
  pstate, msf = _keccakf1600_ref(pstate, msf);
  () = #unspill(ctx_m_rand);

  // FIXME define a function for that
  mu = s_key_rnd_mu[SEEDBYTES + RNDBYTES : CRHBYTES];
  for i = 0 to CRHBYTES/4 {
    t = pstate[i];
    mu[u32 i] = t;
  }
  s_key_rnd_mu[SEEDBYTES + RNDBYTES : CRHBYTES] = mu;

  rnd = s_key_rnd_mu[SEEDBYTES : RNDBYTES];
  reg u32 rand = ctx_m_rand[2];
  for i = 0 to RNDBYTES/4 {
    t = (u32)[rand + 4*i];
    rnd[u32 i] = t;
  }
  s_key_rnd_mu[SEEDBYTES : RNDBYTES] = rnd;

  key_rnd_mu = s_key_rnd_mu;
  pstate, msf = __add_seedrndcrh_ref(pstate, key_rnd_mu, msf);
  pstate, msf = __add_zero_after_add(pstate, SEEDBYTES + RNDBYTES + CRHBYTES, msf);
  pstate = __add_block_end(pstate, SEEDBYTES + RNDBYTES + CRHBYTES, SHAKE256_RATE);
  pstate, msf = _keccakf1600_ref(pstate, msf);
  state = pstate;
  rhoprime = s_rhoprime;
  for i = 0 to CRHBYTES/4 {
    t = pstate[i];
    rhoprime[u32 i] = t;
  }
  s_rhoprime = rhoprime;

  stack u32[matKL] s_mat;
  stack u32[polyvecl] s_y, s_z;
  stack u32[polyveck] s_h;
  reg ptr u32[matKL] mat;
  reg ptr u32[polyveck] h;
  stack u32[polyveck] s_w1 s_w0;
  stack u32[N] s_cp;
  reg ptr u32[polyveck] w1 w0;
  reg ptr u32[N] cp;
  mat = s_mat; rho = s_rho;
  mat, msf = _polyvec_matrix_expand(mat, rho, msf); s_mat = mat;
  s1 = s_s1; s1, msf = _polyvecl_ntt(s1, msf); s_s1 = s1;
  s2 = s_s2; s2, msf = _polyveck_ntt(s2, msf); s_s2 = s2;
  t0 = s_t0; t0, msf = _polyveck_ntt(t0, msf); s_t0 = t0;

  reg u32 continue nonce r0;
  stack u32 s_nonce;
  r0 = 0;
  s_nonce = r0;
  while {
    /* Sample intermediate vector y */
    rhoprime = s_rhoprime;
    nonce = s_nonce;
    s_y, msf = _polyvecl_uniform_gamma1(s_y, rhoprime, nonce, msf);
    nonce = s_nonce; nonce += 1; s_nonce = nonce;

    /* Matrix-vector multiplication */
    s_z, msf = copy_polyvecl(s_z, s_y, msf);
    s_z, msf = _polyvecl_ntt(s_z, msf);
    mat = s_mat;
    w1 = s_w1; w1, msf = _polyvec_matrix_pointwise_montgomery(w1, mat, s_z, msf);
    w1, msf = _polyveck_reduce(w1, msf);
    w1, msf = _polyveck_invntt_tomont(w1, msf);

    /* Decompose w and call the random oracle */
    w1, msf = _polyveck_caddq(w1, msf);
    w0 = s_w0;
    w1, s_w0, msf = _polyveck_decompose_inplace(w1, w0, msf);
    s_w1 = w1;
    () = #unspill(sig);
    reg ptr u8[K * POLYW1_PACKEDBYTES] sig1;
    sig1 = sig[0: K * POLYW1_PACKEDBYTES];
    sig1, msf = _polyveck_pack_w1(sig1, w1, msf);
    sig[0: K * POLYW1_PACKEDBYTES] = sig1;
    () = #spill(sig);
    // SHAKE256
    pstate = state; mu = s_key_rnd_mu[SEEDBYTES + RNDBYTES : CRHBYTES];
    pstate, msf = __add_crh_ref(pstate, mu, msf);
    pstate, msf = __add_zero_after_add(pstate, CRHBYTES, msf);
    pstate, pos, msf = _shake256_inc_absorb_KPOLYW1_PACKEDBYTES_naive(pstate, CRHBYTES, sig1, msf);
    pstate = _shake256_inc_finalize(pstate, pos);
    pstate, msf = _keccakf1600_ref(pstate, msf);
    // FIXME define a function for that

    reg ptr u8[CTILDEBYTES] sigctilde;
    () = #unspill(sig);
    sigctilde = sig[0:CTILDEBYTES];
    for i = 0 to CTILDEBYTES/4 {
      t = pstate[i];
      sigctilde[u32 i] = t;
    }
    state = pstate;
    sig[0:CTILDEBYTES] = sigctilde;

    reg ptr u8[SEEDBYTES] sigseed;
    sigseed = sig[0:SEEDBYTES];
    () = #spill(sig);
    cp = s_cp;
    cp, msf = _poly_challenge(cp, sigctilde, msf);
    cp, msf = _poly_ntt(cp, msf);
    /* Compute z, reject if it reveals secret */
    s1 = s_s1;
    s_z, msf = _polyvecl_pointwise_poly_montgomery(s_z, cp, s1, msf); s_cp = cp;
    s_z, msf = _polyvecl_invntt_tomont(s_z, msf);
    s_z, msf = _polyvecl_add_inplace(s_z, s_y, msf);
    s_z, msf = _polyvecl_reduce(s_z, msf);

    reg u32 chknorm bound;
    bound = iGAMMA1 - BETA;
    chknorm, msf = _polyvecl_chknorm(s_z, bound, msf);
    () = #spill(sig);
    if (chknorm != 0) {
      continue = 1;
    } else {
      s2 = s_s2; h = s_h;
      h, msf = _polyveck_pointwise_poly_montgomery(h, cp, s2, msf);
      h, msf = _polyveck_invntt_tomont(h, msf); s_h = h;
      w0 = s_w0;
      w0, msf = _polyveck_sub_inplace(w0, h, msf);
      w0, msf = _polyveck_reduce(w0, msf);
      s_w0 = w0;
      bound = iGAMMA2 - BETA;
      chknorm, msf = _polyveck_chknorm(w0, bound, msf);
      if (chknorm != 0) {
        continue = 1;
      } else {
        cp = s_cp; t0 = s_t0;
        h = h;  // Needed for regalloc
        h, msf = _polyveck_pointwise_poly_montgomery(h, cp, t0, msf);
        h, msf = _polyveck_invntt_tomont(h, msf);
        h = h; // Needed for regalloc
        h, msf = _polyveck_reduce(h, msf); s_h = h;

        bound = iGAMMA2;
        chknorm, msf = _polyveck_chknorm(h, bound, msf);
        if (chknorm != 0) {
          continue = 1;
        } else {
          w0 = s_w0;
          w0, msf = _polyveck_add_inplace(w0, h, msf);
          s_w0 = w0; w1 = s_w1;
          reg u32 n;
          n, h, msf = _polyveck_make_hint(h, w0, w1, msf); s_h = h;
          if (n > OMEGA) {
            continue = 1;
          } else {
            () = #unspill(sig);
            sig, msf = _pack_sig_nocopy(sig, s_z, h, msf);
            () = #spill(sig);
            continue = 0;
          }
        }
      }
    }
  } (continue == 1)
  status = 0;
  () = #unspill(sig);
  }
  return sig, status, msf;
}

/*************************************************
* Name:        JASMIN_MLDSA_crypto_sign
*
* Description: Compute signed message.
*
* Arguments:   - uint8_t *sm: pointer to output signed message (allocated
*                             array with JASMIN_MLDSA_CRYPTO_BYTES + mlen bytes),
*                             can be equal to m
*              - size_t *smlen: pointer to output length of signed
*                               message
*              - const uint8_t *m: pointer to message to be signed
*              - size_t mlen: length of message
*              - const uint8_t *sk: pointer to bit-packed secret key
*
* Returns 0 (success)
**************************************************/
fn _crypto_sign(reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES] sm, reg u8 m, reg ptr u32[2] smlen_mlen, reg ptr u8[JASMIN_MLDSA_CRYPTO_SECRETKEYBYTES] sk) -> reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES], reg u32 {
    reg u32 status;
    status = -1;
    //TODO
    return sm, status;
}

/*************************************************
* Name:        crypto_sign_verify
*
* Description: Verifies signature.
*
* Arguments:   - uint8_t *m: pointer to input signature
*              - size_t siglen: length of signature
*              - const uint8_t *m: pointer to message
*              - size_t mlen: length of message
*              - const uint8_t *ctx: pointer to context string
*              - size_t ctxlen: length of context string
*              - const uint8_t *pk: pointer to bit-packed public key
*
* Returns 0 if signature could be verified correctly and -1 otherwise
**************************************************/
fn _crypto_sign_verify_ctx(reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES] sig, reg ptr u32[2] ctx_m, reg ptr u32[3] ctxlen_mlen_siglen, reg ptr u8[JASMIN_MLDSA_CRYPTO_PUBLICKEYBYTES] pk, reg u32 msf) -> reg u32, reg u32 {
    reg u32 status;

    stack u8[SEEDBYTES] rho;
    stack u8[CRHBYTES] mu;
    stack u8[CTILDEBYTES] c c2;

    stack u32[polyvecl] z;
    stack u32[polyveck] h, w1, t1;
    stack u32[matKL] mat;
    stack u32[25*2] state;
    stack u32[N] cp;
    stack u8[K * POLYW1_PACKEDBYTES] buf;

    reg u32 ctxlen siglen m mlen ctx t pos;
    reg ptr u32[25*2] pstate;
    reg ptr u8[2] mu2;

    inline int i;

    status = 0;

    ctxlen = ctxlen_mlen_siglen[0];
    siglen = ctxlen_mlen_siglen[2];

    if (ctxlen > 255) { status = - 1; }

    reg u32 tmp;
    tmp = JASMIN_MLDSA_CRYPTO_BYTES;
    if (siglen != tmp) { status = -1; }

    () = #spill(ctxlen_mlen_siglen, ctx_m, ctxlen, status);
    rho, t1 = _unpack_pk(rho, t1, pk);

    reg u32 chk;
    () = #spill(pk);
    c, z, h, chk, msf = _unpack_sig(c, z, h, sig, msf);
    () = #unspill(pk);
    () = #unspill(status);
    () = #spill(sig);

    //FIXME for arm or improve riscv suport
    if (chk == 1) { status = -1; }

    if (status == 0) {
      reg u32 bound;
      bound = iGAMMA1 - BETA;
      chk, msf = _polyvecl_chknorm(z, bound, msf);
      if (chk == 1) { status = -1; }

      if (status == 0) {
        () = #spill(status);
        mu, msf = _shake256_PUBLICKEYBYTES_TRBYTES(mu, pk, msf);

        pstate = state;

        // TRBYTES (64) + 2 < SHAKE256_RATE (136)
        pstate, msf = __add_crh_ref(pstate, mu, msf); // TRBYTES = CRHBYTES

        () = #unspill(ctxlen_mlen_siglen, ctx_m);
        mu2 = mu[0 : 2];
        t = 0;
        mu2[0] = (8u)t;
        t = ctxlen_mlen_siglen[0];
        mu2[1] = (8u)t;
        mu[0 : 2] = mu2;

        () = #spill(ctxlen_mlen_siglen, t, ctx_m, ctxlen_mlen_siglen);
        pstate = __add_mu_ref(pstate, TRBYTES, mu2);
        () = #spill(mu2);
        pstate, msf = __add_zero_after_add_naive(pstate, TRBYTES + 2, msf);
        pos = TRBYTES + 2;
        ctx = ctx_m[0];
        () = #spill(ctx_m, ctxlen_mlen_siglen);
        () = #unspill(ctxlen);
        pstate, pos, msf = _shake256_inc_absorb_mem_naive(pstate, pos, ctx, ctxlen, msf);
        () = #unspill(ctx_m, ctxlen_mlen_siglen);
        mlen = ctxlen_mlen_siglen[1];
        m = ctx_m[1];
        pstate, pos, msf = _shake256_inc_absorb_mem_naive(pstate, pos, m, mlen, msf);
        pstate = _shake256_inc_finalize(pstate, pos);
        pstate, msf = _keccakf1600_ref(pstate, msf);

        // FIXME define a function for that
        for i = 0 to CRHBYTES/4 {
          t = pstate[i];
          mu[u32 i] = t;
        }
        state = pstate;
        () = #spill(pstate);

        cp, msf = _poly_challenge(cp, c[0:CTILDEBYTES], msf);
        mat, msf = _polyvec_matrix_expand(mat, rho, msf);

        z, msf = _polyvecl_ntt(z, msf);
        w1, msf = _polyvec_matrix_pointwise_montgomery(w1, mat, z, msf);

        cp, msf = _poly_ntt(cp, msf);
        t1 = _polyveck_shiftl(t1);
        t1, msf = _polyveck_ntt(t1, msf);
        t1, msf = _polyveck_pointwise_poly_montgomery_inplace(t1, cp, msf);

        w1, msf = _polyveck_sub_inplace(w1, t1, msf);
        w1, msf = _polyveck_reduce(w1, msf);
        w1, msf = _polyveck_invntt_tomont(w1, msf);

        w1, msf = _polyveck_caddq(w1, msf);
        w1 = _polyveck_use_hint_inplace(w1, h);
        buf, msf = _polyveck_pack_w1(buf, w1, msf);

        pstate = state;
        pstate, msf = __add_crh_ref(pstate, mu, msf);
        pstate, msf = __add_zero_after_add(pstate, CRHBYTES, msf);
        pstate, pos, msf = _shake256_inc_absorb_KPOLYW1_PACKEDBYTES_naive(pstate, CRHBYTES, buf, msf);
        pstate = _shake256_inc_finalize(pstate, pos);
        pstate, msf = _keccakf1600_ref(pstate, msf);
        // FIXME define a function for that
        for i = 0 to CTILDEBYTES/4 {
          t = pstate[i];
          c2[u32 i] = t;
        }

        // FIXME : must break early if needed
        () = #unspill(status);
        reg u32 ci c2i;
        for i = 0 to CTILDEBYTES {
          if (status == 0) {
            ci = (32u)c[i];
            c2i = (32u)c2[i];
            if (ci != c2i) {
              status = i + 1;
            }
          }
        }
      }
    }

    return status, msf;
}

