/*************************************************
* Name:        JASMIN_MLDSA_unpack_sig
*
* Description: Unpack signature sig = (c, z, h).
*
* Arguments:   - uint8_t *c: pointer to output JASMIN_MLDSA_challenge hash
*              - polyvecl *z: pointer to output vector z
*              - polyveck *h: pointer to output hint vector h
*              - const uint8_t sig[]: byte array containing
*                bit-packed signature
*
* Returns 1 in case of malformed signature; otherwise 0.
**************************************************/
fn _unpack_sig(reg ptr u8[CTILDEBYTES] c, 
               reg ptr u32[polyvecl] z, 
               reg ptr u32[polyveck] h, 
               reg ptr u8[JASMIN_MLDSA_CRYPTO_BYTES] sig,
               reg u32 msf) ->
         reg ptr u8[CTILDEBYTES], reg ptr u32[polyvecl], reg ptr u32[polyveck], reg u32, reg u32 {
    // fixme this should be in the export function not here
    sig = sig; c = c; z = z; h = h;

    reg u32 status, r0, r1, j, sj, sjm1, sroi, k;
    inline int i;
    inline int start_pos;
    reg ptr u8[CTILDEBYTES] ptsig;
    reg ptr u8[OMEGA + K] pptsig;
    reg ptr u32[N] nh, nz;
    reg ptr u8[POLYZ_PACKEDBYTES] nsig;

    start_pos = 0;
    ptsig = sig[start_pos : CTILDEBYTES];
    c = #copy(ptsig);
    start_pos += CTILDEBYTES;

    () = #spill(c, h);

    for i = 0 to L {
      nz = z[i * N: N];
      nsig = sig[start_pos : POLYZ_PACKEDBYTES];
      z[i * N: N], msf = _polyz_unpack(nz, nsig, msf);
      start_pos += POLYZ_PACKEDBYTES;
    }

    () = #unspill(c, h);
    h = #protect_ptr(h, msf);
    status = 0;
    r0 = 0;
    r1 = 1;
    pptsig = sig[start_pos : OMEGA + K];
    k = 0;    
    for i = 0 to K {

      if (status == 0) {
        msf = #update_msf((status == 0), msf);
        nh = h[i * N: N];
        // FIXME : introduce a local function to not duplicate the code
        j = 0;
        // FIXME improve this loop
        while (j < N) {
          msf = #update_msf((j < N), msf);
          nh[j] = r0;
          j += 1;
        } 
        msf = #update_msf(!(j < N), msf);
        sroi = (32u)pptsig[OMEGA + i];
        sroi = #protect(sroi, msf);
        if (sroi <32u k) {
           msf = #update_msf((sroi <32u k), msf);
           status = 1;
        } else {
           msf = #update_msf(!(sroi <32u k), msf);
        } 

        if (sroi >32u OMEGA) {
           msf = #update_msf((sroi >32u OMEGA), msf);
           status = 1;
        } else {
           msf = #update_msf(!(sroi >32u OMEGA), msf);
        }


        if (status == 0) {
          msf = #update_msf((status == 0), msf);
          j = k;
          sjm1 = (32u)pptsig[j];
          sjm1 = #protect(sjm1, msf);
	  if (j <32u sroi) {
            msf = #update_msf((j <32u sroi), msf);
            nh[sjm1] = r1;
	  } else {
            msf = #update_msf(!(j <32u sroi), msf);
          }
          j += 1; 
          // this is safe because j = k <= OMEGA < OMEGA + K
          sj = (32u)pptsig[j]; 
          sj = #protect(sj, msf);
          while (j <32u sroi) {
            msf = #update_msf((j <32u sroi), msf);
            if (sj <=32u sjm1) { 
              msf = #update_msf((sj <=32u sjm1), msf);
              status = 1;
              j = sroi; // exit loop
            } else {
              msf = #update_msf(!(sj <=32u sjm1), msf);
              j += 1;
              nh[sj] = r1;
              // for the next iteration
              sjm1 = sj;
              // this is safe because j <= sroi <= OMEGA < OMEGA + K
              sj = (32u)pptsig[j];  
              sj = #protect(sj, msf);              
            }              
          } 
          msf = #update_msf(!(j <32u sroi), msf);
          if (status == 0) {
            msf = #update_msf((status == 0), msf);
            k = sroi;
          } else {
            msf = #update_msf(!(status == 0), msf);
          }
          // END FIXME : local function
        } else {
           msf = #update_msf(!(status == 0), msf);
        }
        h[i * N : N] = nh; 
      } else {
        msf = #update_msf(!(status == 0), msf);
      }
    }
    if (status == 0) {
      msf = #update_msf((status == 0), msf);
      j = k;
      while(j <32u OMEGA) {
        msf = #update_msf((j <32u OMEGA), msf);
        sj = (32u)pptsig[j];
        sj = #protect(sj, msf);
        if (sj != 0) {
          msf = #update_msf((sj != 0), msf);
          j = OMEGA;
          status = 1; 
        } else { 
          msf = #update_msf(!(sj != 0), msf);
          j += 1; 
        }
      }
      msf = #update_msf(!(j <32u OMEGA), msf);
    } else {
      msf = #update_msf(!(status == 0), msf);        
    }
    return c, z, h, status, msf;
}
